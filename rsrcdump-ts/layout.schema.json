{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rsrcdump binary resource layout",
  "type": "object",
  "additionalProperties": false,
  "required": ["resources"],
  "properties": {
    "$schema": { "type": "string" },
    "byteOrder": { "enum": ["big", "little"], "default": "big" },
    "types": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/node" }
    },
    "resources": {
      "type": "object",
      "propertyNames": { "minLength": 4, "maxLength": 4 },
      "additionalProperties": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "name": { "type": "string", "minLength": 1 },
    "scalar": { "enum": ["u8", "i8", "u16", "i16", "u32", "i32", "f32", "f64", "bool"] },
    "count": {
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 1000000 },
        { "const": "remaining" },
        {
          "type": "object", "required": ["field"], "additionalProperties": false,
          "properties": { "field": { "$ref": "#/$defs/name" } }
        }
      ]
    },
    "node": {
      "anyOf": [
        { "$ref": "#/$defs/scalar" },
        {
          "type": "object", "required": ["type"], "additionalProperties": false,
          "properties": { "name": { "$ref": "#/$defs/name" }, "type": { "$ref": "#/$defs/scalar" } }
        },
        {
          "type": "object", "required": ["$ref"], "additionalProperties": false,
          "properties": {
            "name": { "$ref": "#/$defs/name" },
            "$ref": { "type": "string", "pattern": "^#/types/[A-Za-z_][A-Za-z0-9_]*$" }
          }
        },
        {
          "type": "object", "required": ["type", "bytes"], "additionalProperties": false,
          "properties": {
            "name": { "$ref": "#/$defs/name" }, "type": { "const": "padding" },
            "bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }
          }
        },
        {
          "type": "object", "required": ["type", "fields"], "additionalProperties": false,
          "properties": {
            "name": { "$ref": "#/$defs/name" }, "type": { "const": "struct" },
            "fields": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/node" } }
          }
        },
        {
          "type": "object", "required": ["type", "count", "items"], "additionalProperties": false,
          "properties": {
            "name": { "$ref": "#/$defs/name" }, "type": { "const": "array" },
            "count": { "$ref": "#/$defs/count" }, "items": { "$ref": "#/$defs/node" }
          }
        }
      ]
    }
  }
}
