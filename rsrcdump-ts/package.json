{
  "name": "@lachlanwright/rsrcdump-ts",
  "version": "1.0.0",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "bin": {
    "rsrcdump-ts": "./bin/rsrcdump-ts.js"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build/**/*.js",
    "build/**/*.d.ts",
    "build/**/*.d.ts.map",
    "!build/**/*.test.js",
    "!build/**/*.test.d.ts",
    "!build/**/*.test.d.ts.map",
    "!build/**/*.test.js.map",
    "bin/",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint --ext .ts .",
    "lint:fix": "eslint --ext .ts . --fix",
    "cli": "tsx src/cli.ts",
    "pack:test": "./scripts/pack-test.sh",
    "example:basic": "tsx examples/basic-usage.ts",
    "example:advanced": "tsx examples/advanced-usage.ts"
  },
  "keywords": [
    "resource-fork",
    "mac",
    "macos",
    "classic-mac",
    "rsrc",
    "resource",
    "converter",
    "json"
  ],
  "author": "Lachlan Wright",
  "license": "MIT",
  "description": "TypeScript port of rsrcdump - Extract and convert Mac resource forks with Result/Err error handling",
  "repository": {
    "type": "git",
    "url": "https://github.com/LachlanBWWright/rsrcdump.git",
    "directory": "rsrcdump-ts"
  },
  "bugs": {
    "url": "https://github.com/LachlanBWWright/rsrcdump/issues"
  },
  "homepage": "https://github.com/LachlanBWWright/rsrcdump#readme",
  "devDependencies": {
    "@types/node": "^25.0.2",
    "@typescript-eslint/eslint-plugin": "^6.6.0",
    "@typescript-eslint/parser": "^6.6.0",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vitest": "^0.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
